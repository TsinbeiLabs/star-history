# GitHub token used only by the server-side Vercel Function.
GITHUB_TOKEN=github_pat_replace_me

# Comma or whitespace separated. Supports owner/repo, owner/*, or explicit *.
ALLOWED_REPOS=TsinbeiLabs/*,star-history/star-history

# Self-hosted branding. Sponsors and external footer links are hidden by default.
NEXT_PUBLIC_SITE_URL=https://star-history.tsinbei.com
NEXT_PUBLIC_SHOW_SPONSORS=false
NEXT_PUBLIC_SHOW_HEADER=false
NEXT_PUBLIC_ENABLE_BLOG=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_FOOTER_TAGLINE=GitHub star history graph
NEXT_PUBLIC_MAINTAINER_NAME=Tsinbei Labs
NEXT_PUBLIC_MAINTAINER_URL=https://github.com/TsinbeiLabs
NEXT_PUBLIC_ORIGINAL_AUTHOR_NAME=
NEXT_PUBLIC_ORIGINAL_AUTHOR_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_RSS_URL=

# JSON array of {"label":"...","url":"...","icon":"optional asset URL"}.
NEXT_PUBLIC_FOOTER_LINKS=[]
